{
  "name": "planchest",
  "version": "0.1.0",
  "description": "A design repo framework for AI agents: one repo for all design material, and a visual diff for reviewing what they produce.",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "planchest": "./bin/planchest.js"
  },
  "files": [
    "dist",
    "bin",
    "docs/design-repo.md",
    "skills",
    "template"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc --noEmit",
    "test": "node --test \"tests/**/*.test.ts\"",
    "prepack": "npm run build"
  },
  "engines": {
    "node": "^22.18.0 || >=23.6.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "typescript": "^5.9.3"
  }
}
