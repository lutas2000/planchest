{
  "name": "planchest",
  "version": "0.1.0",
  "description": "A design repo framework for AI agents: one repo for all design material, and a visual diff for reviewing what they produce.",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "planchest": "./bin/planchest.js"
  },
  "files": [
    "dist",
    "bin",
    "docs/design-repo.md",
    "skills",
    "template",
    "viewer-dist"
  ],
  "scripts": {
    "build": "npm run build:cli && npm run build:viewer",
    "check": "tsc --noEmit && tsc -p viewer/tsconfig.json",
    "test": "node --test \"tests/**/*.test.ts\"",
    "prepack": "npm run build",
    "build:cli": "tsc -p tsconfig.build.json",
    "build:viewer": "vite build --config viewer/vite.config.ts"
  },
  "engines": {
    "node": "^22.18.0 || >=23.6.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.4",
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "tailwindcss": "^4.3.4",
    "typescript": "^5.9.3",
    "vite": "^6.4.5"
  },
  "dependencies": {
    "parse5": "^8.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  }
}
