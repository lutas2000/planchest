{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "color": {
    "primary": { "$type": "color", "$value": "#2f5bea" },
    "on-primary": { "$type": "color", "$value": "#ffffff" },
    "surface": { "$type": "color", "$value": "#ffffff" },
    "on-surface": { "$type": "color", "$value": "#1c1c1a" },
    "surface-variant": { "$type": "color", "$value": "#f3f2ee" },
    "outline": { "$type": "color", "$value": "#e3e2dc" },
    "success": { "$type": "color", "$value": "#1f8a4c" },
    "warning": { "$type": "color", "$value": "#b7791f" },
    "danger": { "$type": "color", "$value": "#c0392b" }
  },
  "font": {
    "sans": { "$type": "fontFamily", "$value": ["Inter", "ui-sans-serif", "system-ui", "sans-serif"] },
    "mono": { "$type": "fontFamily", "$value": ["ui-monospace", "SFMono-Regular", "Menlo", "monospace"] }
  },
  "text": {
    "xs": { "$type": "dimension", "$value": "12px" },
    "sm": { "$type": "dimension", "$value": "14px" },
    "md": { "$type": "dimension", "$value": "16px" },
    "lg": { "$type": "dimension", "$value": "20px" },
    "xl": { "$type": "dimension", "$value": "28px" },
    "xxl": { "$type": "dimension", "$value": "40px" }
  },
  "space": {
    "0": { "$type": "dimension", "$value": "0px" },
    "1": { "$type": "dimension", "$value": "4px" },
    "2": { "$type": "dimension", "$value": "8px" },
    "3": { "$type": "dimension", "$value": "12px" },
    "4": { "$type": "dimension", "$value": "16px" },
    "5": { "$type": "dimension", "$value": "24px" },
    "6": { "$type": "dimension", "$value": "32px" },
    "7": { "$type": "dimension", "$value": "48px" },
    "8": { "$type": "dimension", "$value": "64px" }
  },
  "radius": {
    "sm": { "$type": "dimension", "$value": "4px" },
    "md": { "$type": "dimension", "$value": "8px" },
    "lg": { "$type": "dimension", "$value": "16px" },
    "full": { "$type": "dimension", "$value": "999px" }
  }
}
